<?xml version="1.0" encoding="utf-8"?>
<!-- IIS config for the static Friensys site (Next.js `output: "export"`).
     Requires the IIS URL Rewrite module: https://www.iis.net/downloads/microsoft/url-rewrite -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Old site URLs (permanent redirects) -->
        <rule name="old-schoolErp" stopProcessing="true"><match url="^product/schoolErp/?$" ignoreCase="true" /><action type="Redirect" url="/school-erp" redirectType="Permanent" /></rule>
        <rule name="old-schoolApp" stopProcessing="true"><match url="^product/schoolApp/?$" ignoreCase="true" /><action type="Redirect" url="/products/school-app" redirectType="Permanent" /></rule>
        <rule name="old-escalation" stopProcessing="true"><match url="^product/escalation/?$" ignoreCase="true" /><action type="Redirect" url="/products/escalation" redirectType="Permanent" /></rule>
        <rule name="old-odsas" stopProcessing="true"><match url="^product/ODSAS/?$" ignoreCase="true" /><action type="Redirect" url="/products/odsas" redirectType="Permanent" /></rule>
        <rule name="old-loyalty" stopProcessing="true"><match url="^product/customerLoyalty/?$" ignoreCase="true" /><action type="Redirect" url="/products/customer-loyalty" redirectType="Permanent" /></rule>
        <rule name="old-marketplace" stopProcessing="true"><match url="^product/marketplace/?$" ignoreCase="true" /><action type="Redirect" url="/products/marketplace" redirectType="Permanent" /></rule>
        <rule name="old-collegeErp" stopProcessing="true"><match url="^product/collegeErp/?$" ignoreCase="true" /><action type="Redirect" url="/products/college-erp" redirectType="Permanent" /></rule>
        <rule name="old-product" stopProcessing="true"><match url="^product/?$" ignoreCase="true" /><action type="Redirect" url="/products" redirectType="Permanent" /></rule>
        <rule name="old-privacy" stopProcessing="true"><match url="^privacyPolicy/?$" ignoreCase="true" /><action type="Redirect" url="/legal/privacy-policy" redirectType="Permanent" /></rule>
        <rule name="old-cancellation" stopProcessing="true"><match url="^cancellationPolicy/?$" ignoreCase="true" /><action type="Redirect" url="/legal/cancellation-policy" redirectType="Permanent" /></rule>
        <rule name="old-underDevelopment" stopProcessing="true"><match url="^underDevelopment/?$" ignoreCase="true" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
        <rule name="old-services" stopProcessing="true"><match url="^services/services/?$" ignoreCase="true" /><action type="Redirect" url="/services" redirectType="Permanent" /></rule>
        <rule name="old-cloud" stopProcessing="true"><match url="^services/cloudSolutions/?$" ignoreCase="true" /><action type="Redirect" url="/services/modernisation-support" redirectType="Permanent" /></rule>
        <rule name="old-itConsulting" stopProcessing="true"><match url="^services/itConsulting/?$" ignoreCase="true" /><action type="Redirect" url="/services/consulting" redirectType="Permanent" /></rule>
        <rule name="old-softwareDev" stopProcessing="true"><match url="^services/softwareDevelopment/?$" ignoreCase="true" /><action type="Redirect" url="/services/custom-software" redirectType="Permanent" /></rule>
        <rule name="old-softwareProduct" stopProcessing="true"><match url="^services/softwareProduct/?$" ignoreCase="true" /><action type="Redirect" url="/products" redirectType="Permanent" /></rule>
        <rule name="old-apply" stopProcessing="true"><match url="^apply/?$" ignoreCase="true" /><action type="Redirect" url="/careers" redirectType="Permanent" /></rule>
        <rule name="old-customers" stopProcessing="true"><match url="^customers/?$" ignoreCase="true" /><action type="Redirect" url="/case-studies" redirectType="Permanent" /></rule>

        <!-- Drop trailing slash: /about/ -> /about -->
        <rule name="no-trailing-slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions><add input="{REQUEST_FILENAME}.html" matchType="IsFile" /></conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Clean URLs: /about serves about.html -->
        <rule name="clean-urls" stopProcessing="true">
          <match url="^(.+?)/?$" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" /><add input="{REQUEST_FILENAME}.html" matchType="IsFile" /></conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" /><mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".txt" /><mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
      <!-- Extensionless files, e.g. /api/llms-full -->
      <remove fileExtension="." /><mimeMap fileExtension="." mimeType="text/plain; charset=utf-8" />
    </staticContent>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Long cache for hashed build assets -->
  <location path="_next/static">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" /></staticContent>
    </system.webServer>
  </location>
</configuration>
